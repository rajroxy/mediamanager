{
  "name": "scriptforge",
  "version": "1.0.0",
  "private": true,
  "description": "ScriptForge media player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "player": "electron . --app=player",
    "manager": "electron . --app=manager",
    "preview": "node server.js",
    "dist:player": "electron-builder --config electron-builder.player.yml",
    "dist:manager": "electron-builder --config electron-builder.manager.yml"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
